# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
POSTGRES_DB=psc_drfms
POSTGRES_USER=psc_user
POSTGRES_PASSWORD=psc_secure_password
DATABASE_URL=postgresql://psc_user:psc_secure_password@db:5432/psc_drfms

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=psc-drfms-documents
MINIO_USE_HTTPS=False

# Semantic search ("match by meaning")
# gemini = Google Gemini API, free tier. Record text IS SENT TO GOOGLE, so only records up to
#          the classification ceiling below are ever sent. Get a key at https://aistudio.google.com/apikey
# ollama = a local Ollama server (not included in docker-compose); nothing leaves the deployment.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# unclassified | internal | confidential | restricted | secret
EMBEDDING_EXTERNAL_MAX_CLASSIFICATION=internal
# Set to False to turn semantic search off (keyword search keeps working)
SEMANTIC_SEARCH_ENABLED=True

# Generative AI: Ask the archive, summaries, metadata/retention/sensitivity suggestions,
# and plain-English search filters. Off until you choose a model.
#   none      = AI features off (default)
#   anthropic = Claude (set ANTHROPIC_API_KEY)      } text IS SENT to the vendor, but only for
#   gemini    = Google Gemini (set GEMINI_API_KEY)  } records up to LLM_EXTERNAL_MAX_CLASSIFICATION
#   ollama    = a model you run yourself; nothing leaves the deployment
# Hybrid: LLM_PROVIDER=anthropic and LLM_LOCAL_PROVIDER=ollama sends higher classifications to your own server.
# With no local provider, records above the ceiling get no AI at all.
LLM_PROVIDER=none
LLM_LOCAL_PROVIDER=none
LLM_EXTERNAL_MAX_CLASSIFICATION=internal
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_LLM_MODEL=gemini-2.5-flash
# OLLAMA_LLM_MODEL=llama3.1
# OLLAMA_VISION_MODEL=llava    # lets Ollama read handwriting/poor scans
# Fill EMPTY document type / ministry / date automatically at this confidence (0 = never). Classification and retention are never automatic.
AI_AUTOFILE_CONFIDENCE=0
LLM_RATE_LIMIT_PER_MINUTE=20

# Email (Django SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@psc.gov.vu
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PSC-DRFMS <noreply@psc.gov.vu>

# Email ingestion (IMAP - email-to-record feature)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=records@psc.gov.vu
IMAP_PASSWORD=your-imap-password
IMAP_MAILBOX=INBOX

# SAML / SSO (Phase 3 - Government Active Directory)
SAML_ENABLED=False
SAML_SP_ENTITY_ID=https://drfms.psc.gov.vu
SAML_IDP_METADATA_URL=https://ad.gov.vu/FederationMetadata/2007-06/FederationMetadata.xml

# 2FA
OTP_TOTP_ISSUER=PSC-DRFMS

# Security
SESSION_COOKIE_AGE=28800
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# OnlyOffice Document Server (host port mapped in docker-compose)
ONLYOFFICE_JWT_SECRET=psc_drfms_oo_secret_change_in_prod
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
ONLYOFFICE_PORT=8082

DJANGO_SUPERUSER_EMAIL=admin@psc.gov.vu
DJANGO_SUPERUSER_PASSWORD=Admin@123!
DJANGO_SUPERUSER_USERNAME=admin
